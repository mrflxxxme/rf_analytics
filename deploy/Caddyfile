# Внутренний Caddy RADAR: статика и /api/* → rf-analytics-api. TLS и домен — на edge-caddy.
# Раскладка /srv/static (workflow web.yml): / и /fakty/, /metodologiya/, sitemap.xml, robots.txt —
# индексируемый слой фактов (T2.5, D27); /karta/ — приложение; /api/ — API. Оба noindex.
# Поведение заголовков проверяет job caddy в web.yml (curl с разными Host).
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# Индексируются только страницы фактов и только на своём домене (D27, D28): временный адрес
	# *.sslip.io закрыт целиком, чтобы поиск не запомнил его до переезда на nishemer.ru (R14).
	# Всё прочее, включая будущие пути, — noindex. edge-caddy проксирует с исходным Host.
	@facts {
		path / /index.html /fakty/* /metodologiya/* /sitemap.xml /robots.txt /facts.css
		expression `!{http.request.host}.endsWith(".sslip.io")`
	}
	@noindex {
		not path /api/*
		not {
			path / /index.html /fakty/* /metodologiya/* /sitemap.xml /robots.txt /facts.css
			expression `!{http.request.host}.endsWith(".sslip.io")`
		}
	}
	# /api/* ставит X-Robots-Tag сам (middleware rf_api) — здесь не дублируем.
	header @noindex X-Robots-Tag "noindex, nofollow"

	# Ассеты приложения с хешем в имени — надолго; страницы фактов — на час.
	header /karta/assets/* Cache-Control "public, max-age=31536000, immutable"
	header @facts Cache-Control "public, max-age=3600"

	handle /api/* {
		reverse_proxy rf-analytics-api:8000
	}
	handle {
		root * /srv/static
		file_server
	}
}
