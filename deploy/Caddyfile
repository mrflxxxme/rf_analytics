# Внутренний Caddy RADAR: статика и /api/* → rf-analytics-api. TLS и домен — на edge-caddy.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	# До T2.5 всё приложение noindex (D27); страницы фактов получат индексацию отдельным правилом.
	header X-Robots-Tag "noindex, nofollow"
	handle /api/* {
		reverse_proxy rf-analytics-api:8000
	}
	handle {
		root * /srv/static
		file_server
	}
}
